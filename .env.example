# QuestLab — Environment Variables
# Copy this file to .env and fill in values

# Database (local dev)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/gamified_learning"

# Database (production — Railway provides this)
# DATABASE_URL="postgresql://..."

# NextAuth
AUTH_SECRET="change-me-to-a-random-string-at-least-32-chars"
AUTH_URL="http://localhost:3200"

# AI Provider (DeepSeek)
DEEPSEEK_API_KEY="sk-your-key-here"
DEEPSEEK_MODEL_PRO="deepseek-v4-pro"
DEEPSEEK_MODEL_FLASH="deepseek-v4-flash"
